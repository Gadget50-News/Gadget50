# Never execute uploaded files as scripts. Images remain downloadable, but all common
# PHP handler extensions are denied even if an attacker manages to upload a file with one.
<FilesMatch "\.(php|phtml|php[0-9]+|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

Options -ExecCGI
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
